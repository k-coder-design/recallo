{
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["electron.vite.config.ts", "vitest.config.ts", "vite.mobile.config.ts", "src/main/**/*", "src/preload/**/*", "src/shared/**/*", "src/mcp/**/*", "src/*.test.ts", "scripts/**/*"]
}
